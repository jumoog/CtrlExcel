// Version resource of CtrlExcelReader.dll (Properties > Details in Explorer,
// or (Get-Item CtrlExcelReader.dll).VersionInfo in PowerShell).
// CtrlExcelVersion.h is generated on every build by cmake/VersionInfo.cmake:
// the version comes from CMakeLists.txt, the revision from git, so the
// ProductVersion (e.g. "1.0.0+a5f43da") names the commit a DLL was built from.

#include <windows.h>
#include "CtrlExcelVersion.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    CTRLEXCEL_VERSION_MAJOR,CTRLEXCEL_VERSION_MINOR,CTRLEXCEL_VERSION_PATCH,0
 PRODUCTVERSION CTRLEXCEL_VERSION_MAJOR,CTRLEXCEL_VERSION_MINOR,CTRLEXCEL_VERSION_PATCH,0
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
#if defined(_DEBUG) && CTRLEXCEL_DIRTY
 FILEFLAGS      VS_FF_DEBUG | VS_FF_PRIVATEBUILD
#elif defined(_DEBUG)
 FILEFLAGS      VS_FF_DEBUG
#elif CTRLEXCEL_DIRTY
 FILEFLAGS      VS_FF_PRIVATEBUILD
#else
 FILEFLAGS      0
#endif
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_DLL
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0" // U.S. English, Unicode
        BEGIN
            VALUE "CompanyName",      "Kilian von Pflugk"
            VALUE "FileDescription",  "WinCC OA CTRL extension: read and write Excel .xlsx files"
            VALUE "FileVersion",      CTRLEXCEL_VERSION
            VALUE "InternalName",     "CtrlExcelReader"
            VALUE "LegalCopyright",   "Copyright (c) 2026 Kilian von Pflugk, MIT License"
            VALUE "OriginalFilename", "CtrlExcelReader.dll"
            VALUE "ProductName",      "CtrlExcelReader"
            VALUE "ProductVersion",   CTRLEXCEL_PRODUCT_VERSION
            VALUE "Comments",         CTRLEXCEL_COMMENTS
#if CTRLEXCEL_DIRTY
            VALUE "PrivateBuild",     "Built with uncommitted changes"
#endif
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
